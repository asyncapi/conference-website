NEXT_PUBLIC_PRETALX_BASE_URL="http://localhost:8346"
# Production: NEXT_PUBLIC_PRETALX_BASE_URL="https://cfp.asyncapi.com"
NEXT_PUBLIC_PRETALX_CFP_PATH="cfp"

# Conference registration (2026) via Supabase
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your supabase service role key"
REGISTRATION_2026_TABLE="conference_registrations_2026"
GOOGLE_APP_PASSWORD="your google accounts app password, needed to send registration emails"
ASYNCAPI_EMAIL="your email"

# Gallery (/gallery) reads photos from Cloudinary. Optional locally: without
# it the page shows an empty state. Set in Netlify for production.
# Copy the URL from the Cloudinary dashboard (or set CLOUDINARY_CLOUD_NAME,
# CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET separately).
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# Root folder in the Media Library that holds one sub-folder per event
CLOUDINARY_GALLERY_FOLDER="conference-gallery"
